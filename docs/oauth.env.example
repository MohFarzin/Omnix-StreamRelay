# Copy to the egg volume as data/oauth.env (never commit real secrets).
# Streamers do not fill these in the panel — operators / OmnixStudio only.

YOUTUBE_OAUTH_SCHEME=http

# --- Direct apps on one host (lab / Mumbai) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# Redirects (defaults are fine if PUBLIC_HOST + PORT match):
# YOUTUBE_REDIRECT_URI=http://HOST:PORT/api/v1/youtube/oauth/callback
# TWITCH_REDIRECT_URI=http://HOST:PORT/api/v1/oauth/callback/twitch
# KICK_REDIRECT_URI=http://HOST:PORT/api/v1/oauth/callback/kick

# --- Omnix OAuth broker (recommended for public / many hosts) ---
# OAUTH_BROKER_URL=https://auth.omnixstudio.xyz
# OAUTH_BROKER_SECRET=shared-with-broker-BROKER_SECRET
