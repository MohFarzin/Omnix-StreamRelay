# Omnix StreamRelay — copy to .env and fill in

DOMAIN=stream.example.com
ACME_EMAIL=you@example.com

# 32+ byte secrets (generate: openssl rand -hex 32)
MASTER_KEY=
BOOTSTRAP_TOKEN=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MediaMTX
MTX_PUBLISH_PASS=change-me-publish
MTX_API_PASS=change-me-api
# OBS stream key path segment → rtmp://DOMAIN:1935/live/STREAM_KEY
STREAM_KEY=mystream
# Optional vertical / Aitum path (defaults to STREAM_KEY + _v)
STREAM_KEY_VERTICAL=mystream_v

# Optional: set to 1 only if Kick needs re-encode (default is -c copy)
# KICK_TRANSCODE=0

# Optional platform credentials (also editable later via encrypted SQLite for RTMP keys)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL=
TWITCH_BOT_USER_ID=

YOUTUBE_API_KEY=
# Operator-only (prefer data/oauth.env on egg). Streamers use Connect in the panel.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_LIVE_CHAT_ID=
# Omnix OAuth broker (Streamlabs-style Connect for public builds)
# OAUTH_BROKER_URL=https://auth.omnixstudio.xyz
# OAUTH_BROKER_SECRET=
# YOUTUBE_OAUTH_SCHEME=http

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_ACCESS_TOKEN=
KICK_CHANNEL=
