# Omnix StreamRelay — copy to .env and fill in

DOMAIN=stream.example.com
ACME_EMAIL=you@example.com

# 32+ byte secrets (generate: openssl rand -hex 32)
MASTER_KEY=
BOOTSTRAP_TOKEN=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MediaMTX
MTX_PUBLISH_PASS=change-me-publish
MTX_API_PASS=change-me-api
# OBS stream key path segment → rtmp://DOMAIN:1935/live/STREAM_KEY
STREAM_KEY=mystream

# Optional platform credentials (also editable later via encrypted SQLite for RTMP keys)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL=
TWITCH_BOT_USER_ID=

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_LIVE_CHAT_ID=

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_ACCESS_TOKEN=
KICK_CHANNEL=
