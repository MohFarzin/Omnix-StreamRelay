{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnix StreamRelay",
  "version": "1.0.0",
  "identifier": "xyz.omnixstudio.streamrelay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omnix StreamRelay",
        "width": 420,
        "height": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.png"]
  }
}
